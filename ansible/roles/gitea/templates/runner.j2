enabled: true
statefulset:
  extraVolumes:
    - name: docker-certs
      secret:
        secretName: gitea-ca-secret
        items:
          - key: ca.crt
            path: ca.crt
  actRunner:
    tag: 0.5.0
  
  dind:
    extraArgs:
      - --insecure-registry=gitea-http:3000
      - --insecure-registry=gitea.k3s.home:443
    extraVolumeMounts:
      - name: docker-certs
        mountPath: /gitea-ca          # file lands at /gitea-ca/ca.crt
        readOnly: true
    extraEnvs:
      - name: SSL_CERT_DIR
        value: /gitea-ca:/etc/ssl/certs

existingSecret: gitea-act-runner-secret
existingSecretKey: token
giteaRootURL: http://gitea-http:3000
